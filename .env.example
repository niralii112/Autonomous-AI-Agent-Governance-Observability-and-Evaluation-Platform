# Copy to .env and replace every CHANGE_ME value. Never commit .env.
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

POSTGRES_USER=governance_user
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_DB=governance_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://governance_user:CHANGE_ME_LOCAL_ONLY@localhost:5432/governance_db

JWT_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_64_HEX
JWT_ALGORITHM=HS256
JWT_ISSUER=agent-governance-platform
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

EXECUTION_GRANT_SECRET=CHANGE_ME_GENERATE_RANDOM_64_HEX
EXECUTION_GRANT_TTL_SECONDS=60
EXECUTION_TIMEOUT_SECONDS=30
EXECUTION_MAX_ATTEMPTS=3
APPROVAL_TTL_SECONDS=3600
APPROVAL_SWEEP_INTERVAL_SECONDS=30

GOVERNANCE_NO_MATCH_DECISION=HUMAN_REVIEW
RISK_THRESHOLD_MEDIUM=0.30
RISK_THRESHOLD_HIGH=0.60
RISK_THRESHOLD_CRITICAL=0.85
RISK_MODEL_ARTIFACT_DIR=backend/artifacts
RISK_MODEL_VERSION=risk-logreg-1.0.0

OTEL_TRACES_ENABLED=true
OTEL_SERVICE_NAME=governance-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
JAEGER_QUERY_URL=http://localhost:16686
TELEMETRY_QUERY_TIMEOUT_SECONDS=5

SEED_ADMIN_PASSWORD=CHANGE_ME_SEED_ADMIN
SEED_REVIEWER_PASSWORD=CHANGE_ME_SEED_REVIEWER
SEED_OPERATOR_PASSWORD=CHANGE_ME_SEED_OPERATOR
SEED_VIEWER_PASSWORD=CHANGE_ME_SEED_VIEWER

POSTGRES_IMAGE=postgres:16-alpine
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:latest
JAEGER_IMAGE=jaegertracing/jaeger:latest

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_USE_MOCKS=false
